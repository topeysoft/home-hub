// Copy to secrets.h and fill in. secrets.h is gitignored and must stay that way:
// it carries your WiFi password and the mesh network keys.
//
// Generate the key blocks from your mesh store with:
//     python3 brilliant/tools/make_secrets.py > brilliant/esp32-bridge/include/secrets.h
#pragma once

#define WIFI_SSID   "your-ssid"
#define WIFI_PASS   "your-password"

#define MQTT_HOST   "192.168.86.42"     // hub.local
#define MQTT_PORT   1883
#define MQTT_USER   ""
#define MQTT_PASS   ""
#define MQTT_BASE   "brilliant"

// 16-byte mesh keys -- from ~/.config/brilliant-mesh/mesh-net.json
static const uint8_t NET_KEY[16] = {0x00};
static const uint8_t APP_KEY[16] = {0x00};
static const uint8_t DEV_KEY[16] = {0x00};

#define PROVISIONER_ADDR  0x0001    // the roaming provisioner (laptop)
#define NODE_ADDR         0x0002    // the switch this bridge talks to
#define IV_INDEX          0
