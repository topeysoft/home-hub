# install.sh writes this for you. Edit only if you know why.
TZ=America/New_York
HUB_HOST=hub.local
HUB_IP=192.168.1.50

# Radios. radios.sh finds the sticks and turns the matching profiles on; "none" starts without radios.
# Find them by hand with: ls -l /dev/serial/by-id/
# A radio on the network instead of USB (Ethernet Zigbee coordinator, PoE Z-Wave dongle): set these
# by hand and radios.sh treats them as found. The host then needs no USB at all.
#ZIGBEE_NET=tcp://slzb-06.local:6638
#ZWAVE_NET=tcp://zwave-dongle.local:5000
COMPOSE_PROFILES=none
ZIGBEE_SERIAL=/dev/serial/by-id/usb-Nabu_Casa_SkyConnect_v1.0_XXXX-if00-port0
ZWAVE_SERIAL=/dev/serial/by-id/usb-Zooz_800_Z-Wave_Stick_XXXX-if00
# Nortek HUSBZB-1 instead: ZWAVE_SERIAL=/dev/serial/by-id/usb-Silicon_Labs_HubZ_Smart_Home_Controller_XXXX-if00-port0
# The Zigbee stick's chip family, which Zigbee2MQTT cannot always work out for itself. Left unset it is
# ember: Silicon Labs, which is the SkyConnect, the ZBT-1 and ZBT-2, and the Sonoff ZBDongle-E. A TI
# stick (the Sonoff ZBDongle-P, anything CC2652) wants zstack. Change it, then `docker compose up -d`.
#ZIGBEE_ADAPTER=zstack
ZWAVE_SESSION_SECRET=change-me-to-a-long-random-string

# Messages (Mosquitto) take a password. mqtt-auth.sh makes these once and writes the broker's password
# file from them; docker-compose.yml hands them to Zigbee2MQTT, Ring and the brain, and the brain gives
# them to the engine. Letters and digits only: the value travels in a URL.
#MQTT_USER=hub
#MQTT_PASSWORD=

# The house's own voice. Off, and off is what every house is today: nothing can hear yet, so there is
# nothing to answer. To turn it on, add "voice" to COMPOSE_PROFILES above (radios.sh keeps it there
# when a stick comes and goes) and set VOICE_TTS=piper. The first start fetches the voice model into
# ./piper-data and needs the internet once; everything after that is local. docs/voice.md.
#VOICE_TTS=piper
#VOICE_TTS_VOICE=en_GB-alba-medium
#VOICE_TTS_PORT=10200

# The brain image to run. CI publishes it for amd64 and arm64; leave unset for the published one,
# or point at a local build (docker compose build brain) while developing.
#HUB_BRAIN_IMAGE=ghcr.io/topeysoft/home-hub-brain:latest

# Developer overrides for the brain when it runs outside Docker. The brain normally finds the engine
# at http://localhost:8123 and creates its own login during setup; these are only for pointing it elsewhere.
#HA_URL=http://localhost:8123
#HA_TOKEN=
# Sky fallback when no location has been chosen on the panel yet. Decimal degrees.
#HOME_LAT=
#HOME_LON=
# Where HA reaches the other containers. localhost with host networking (the Pi); the brain uses it when it adds
# MQTT, Z-Wave and Matter to HA itself. On the Mac compose (bridge network) it is the container name, mosquitto.
#HUB_DRIVER_HOST=localhost
